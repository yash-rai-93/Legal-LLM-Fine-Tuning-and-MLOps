{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSubmissionReservations",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:__AWS_ACCOUNT_ID__:table/legal-llm-cpu-submissions"
    },
    {
      "Sid": "AtomicReservationAndTerminalStatusOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:__AWS_ACCOUNT_ID__:table/legal-llm-cpu-submissions",
      "Condition": {"ForAnyValue:StringEquals": {"dynamodb:EnclosingOperation": ["TransactWriteItems"]}}
    },
    {
      "Sid": "StartExactPublishedCpuWorkflow",
      "Effect": "Allow",
      "Action": "states:StartExecution",
      "Resource": "arn:aws:states:us-east-1:__AWS_ACCOUNT_ID__:stateMachine:legal-llm-cpu-prepare",
      "Condition": {
        "ForAnyValue:StringEquals": {"states:StateMachineQualifier": ["__WORKFLOW_VERSION_NUMBER__"]},
        "Null": {"states:StateMachineQualifier": "false"}
      }
    },
    {
      "Sid": "VerifyOnlyCpuProjectSettings",
      "Effect": "Allow",
      "Action": "codebuild:BatchGetProjects",
      "Resource": "arn:aws:codebuild:us-east-1:__AWS_ACCOUNT_ID__:project/legal-llm-cpu-check"
    },
    {
      "Sid": "ReadOnlyApiExecutionStatus",
      "Effect": "Allow",
      "Action": "states:DescribeExecution",
      "Resource": "arn:aws:states:us-east-1:__AWS_ACCOUNT_ID__:execution:legal-llm-cpu-prepare:api-*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/legal-llm-cpu-submission-api:*"
    }
  ]
}
