{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "states.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "__AWS_ACCOUNT_ID__"
        },
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:states:us-east-1:__AWS_ACCOUNT_ID__:stateMachine:legal-llm-cpu-prepare"
        }
      }
    }
  ]
}
