{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyCpuBuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds",
        "codebuild:StopBuild"
      ],
      "Resource": "arn:aws:codebuild:us-east-1:__AWS_ACCOUNT_ID__:project/legal-llm-cpu-check"
    },
    {
      "Sid": "ObserveCpuBuildCompletion",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:PutTargets",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:us-east-1:__AWS_ACCOUNT_ID__:rule/StepFunctionsGetEventForCodeBuildStartBuildRule"
    }
  ]
}
