{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "execute-api:Invoke",
      "Resource": [
        "arn:aws:execute-api:us-east-1:__AWS_ACCOUNT_ID__:__HTTP_API_ID__/*/GET/datasets",
        "arn:aws:execute-api:us-east-1:__AWS_ACCOUNT_ID__:__HTTP_API_ID__/*/GET/prompts",
        "arn:aws:execute-api:us-east-1:__AWS_ACCOUNT_ID__:__HTTP_API_ID__/*/GET/evaluations/*"
      ]
    }
  ]
}
