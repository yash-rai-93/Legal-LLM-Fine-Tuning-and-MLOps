{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectArtifactBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::yash-legal-llm-cpu-20261022"
    },
    {
      "Sid": "PublishAndVerifyOnlyCpuRunArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::yash-legal-llm-cpu-20261022/runs/*"
    }
  ]
}
